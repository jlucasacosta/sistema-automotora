# Copiá este archivo a .env.local y completá los valores. .env.local NO se sube a git.
# Este repo es un demo sin backend: no necesita ninguna de estas variables para correr.
# Se usan cuando conectás tu propio backend (ver docs/IMPLEMENTAR.md).
# Acá van SOLO placeholders vacíos: nunca pegues una clave real en este archivo.

# --- Supabase (base de datos + Auth). Project Settings > API ---
# La URL y la clave pública (anon / publishable) son seguras en el navegador SOLO con RLS activado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clave service_role ignora el RLS: JAMÁS va al frontend ni con prefijo NEXT_PUBLIC_.
# Solo se usa en un servidor (por ejemplo el worker de Railway). No la cargues en Vercel salvo que
# un Route Handler propio la necesite, y nunca la uses en un componente de cliente.
# SUPABASE_SERVICE_ROLE_KEY=

# --- IA (solo servidor: Route Handler o Server Action) ---
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
